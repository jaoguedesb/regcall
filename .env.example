# Porta do servidor (Render/Railway definem isso automaticamente)
PORT=3000

# ---------------------------------------------------------------
# TURN (MUITO IMPORTANTE para funcionar fora da mesma rede)
# ---------------------------------------------------------------
# Sem TURN, ~15-20% das conexoes falham (redes corporativas, 4G/5G,
# CGNAT). Com TURN, funciona em praticamente qualquer lugar.
#
# Opcao gratuita rapida: crie conta em https://www.metered.ca/tools/openrelay/
# ou use um coturn proprio.
#
# Pode colocar varios servidores separando por virgula.
TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# STUN extra (opcional). Ja existem defaults do Google.
STUN_URLS=

# Nome exibido na aba do navegador
APP_NAME=RegCall

# Se definido, so quem souber a senha entra na plataforma (opcional)
SERVER_PASSWORD=

# Arquivo que guarda salas, canais e mensagens entre reinicios.
# Em Railway/Render, aponte para um volume persistente montado.
REGCALL_DATA_FILE=./data/regcall.json

# Horas ate apagar uma sala vazia. Zero mantem as salas indefinidamente.
ROOM_TTL_HOURS=0
